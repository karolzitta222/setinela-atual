<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Midia-indoor</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background-color: #172554;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }

        .tv-container {
            display: flex;
            width: 95vw;
            height: 90vh;
            gap: 18px;
        }

        .left-panel {
            display: flex;
            flex-direction: column;
            width: 35%;
            gap: 18px;
        }

        .box {
            background-color: white;
            border: 2px solid #6d7fd8;
            border-radius: 15px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        .box-title {
            color: #304a9e;
            font-size: 2.2vw;
            font-weight: bold;
            text-transform: uppercase;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.15);
            margin-bottom: 12px;
        }

        .local-box {
            flex: 1;
            background-color: #e8efff;
        }

        .local-number {
            color: #5538b5;
            font-size: 9vw;
            font-weight: bold;
            line-height: 1;
        }

        .local-type {
            color: #555;
            font-size: 1.8vw;
            font-weight: bold;
            margin-top: 6px;
        }

        .history-box {
            flex: 1;
            justify-content: flex-start;
            align-items: flex-start;
            background-color: #f1edff;
        }

        .history-box .box-title {
            font-size: 1.8vw;
            align-self: center;
            color: #513b9e;
        }

        #history-list {
            list-style: none;
            width: 100%;
            color: #394f9c;
            font-size: 1.5vw;
            font-weight: bold;
            text-align: left;
        }

        #history-list li {
            margin-bottom: 8px;
            border-bottom: 1px solid #b8c2e8;
            padding-bottom: 5px;
        }

        .right-panel {
            display: flex;
            flex-direction: column;
            width: 65%;
            gap: 25px;
        }

        .patient-box {
            flex: 3;
            background-color: #f8faff;
            border: 3px solid #5369d8;
        }

        .patient-name {
            color: #5538b5;
            font-size: 6.5vw;
            font-weight: bold;
            line-height: 1.2;
            word-break: break-word;
        }

        .logo-box {
            flex: 1;
            background-color: #3d4fa3;
        }

        .logo-text {
            color: #ffffff;
            font-size: 3.5vw;
            font-weight: bold;
            text-transform: uppercase;
        }

        @keyframes flash {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.3;
            }
        }

        .flash {
            animation: flash 0.5s ease 3;
        }

        @media (max-width: 700px) {
            .tv-container {
                width: 95vw;
                height: 90vh;
                gap: 10px;
            }

            .left-panel {
                width: 35%;
                gap: 10px;
            }

            .right-panel {
                width: 65%;
                gap: 15px;
            }

            .box {
                padding: 10px;
            }
        }
    </style>
</head>

<body>

    <!---Estrutura da tela da TV criada para exibir
    o local e o nome do paciente chamado-->

    <div class="tv-container">
        <div class="left-panel">
            <div class="box local-box">
                <div class="box-title" id="local-tipo">GUICHE</div>
                <div class="local-number" id="local-numero">---</div>
            </div>

            <div class="box history-box">
                <div class="box-title">ULTIMAS CHAMADAS</div>
                <ul id="history-list"></ul>
            </div>
        </div>

        <div class="right-panel">
            <div class="box patient-box">
                <div class="box-title">PACIENTE</div>
                <div class="patient-name" id="patient-name">AGUARDANDO...</div>
            </div>

            <div class="box logo-box">
                <div class="logo-text">🏥 sistema hospitalar</div>
            </div>
        </div>
    </div>

    <script>
        let ultimoID = null;

        //funcao criada para buscar a chamada atual e o historico real da tv em tempo real
        function atualizar() {
            fetch("/tv/chamada")
            .then(r => r.json())
            .then(data => {
                const chamada = data.chamada;
                const historico = data.historico || [];

                if (chamada) {
                    document.getElementById("local-tipo").innerText = chamada.localTipo || "GHICHÊ";
                    document.getElementById("local-numero").innerText = chamada.localNumero || "--";
                    document.getElementById("patient-name").innerText = chamada.paciente || "AGUARDANDO...";

                    // flash visual quando ha chamada nova
                    if (chamada.id !==ultimoID) {
                        ultimoID = chamada.id;
                        const patientBox = document.querySelector(".patient-box");
                        patientBox.classList.remove("flash");
                        void patientBox.offsetWidth;
                        patientBox.classList.add("flash");
                    }
                }

                // historico
                const list = document.getElementById("history-list");
                list.innerHTML = "";

                historico.slice(0, 4).forEach(h => {
                    const li = document.createElement("li");
                    const tipo = h.localTipo ? h.localTipo.substring(0,4) : "GUIC";
                    li.innerText = `${tipo}. ${h.localNumero} - ${h.paciente}`;
                    list.appendChild(li);
                });
            })
            .catch(err => console.log("Erro ao buscar chamada:", err));
        }

        //polling a cada 2 segundos
        atualizar();
        setInterval(atualizar, 2000);
    </script>

</body>
</html>
